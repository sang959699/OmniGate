<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="MatterDotNet" Version="0.5.0" />
    <PackageReference Include="MiHome.Net" Version="1.1.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <!-- Matter fabric state belongs to the machine running OmniGate, not the release package. -->
  <ItemGroup>
    <None Update="fabric.bin" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="fabric.key" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />

    <!-- These files belong to the machine running OmniGate, not the release package. -->
    <Content Update="names.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="hidden.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="xiaomi-purifier.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="xiaomi-purifier-token.dat" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
